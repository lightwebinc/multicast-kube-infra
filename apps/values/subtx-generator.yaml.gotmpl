# subtx-generator values — load-test client, opt-in.
mode: {{ .Values.subtxGenerator.mode | quote }}
workloadType: {{ .Values.subtxGenerator.workloadType | quote }}

args:
  addr: "[fd20::20]:8725"      # proxy tx ingress; matches fabricAddrs.proxy

subtxGen:
  shardBits: {{ .Values.shared.shardBits }}
  pps: {{ .Values.subtxGenerator.pps }}
  duration: {{ .Values.subtxGenerator.duration | quote }}
  payloadSize: 512
  # Explicit (not inherited): the fabric is EF-native, so the generator emits
  # BRC-30 EF payloads regardless of which chart version is pinned (chart
  # <= 0.3.0 still pins brc124 as its default). Every payload is exactly one
  # valid tx of payloadSize bytes.
  payloadFormat: "brc128"

job:
  completions: 1
  parallelism: 1
  ttlSecondsAfterFinished: 600

networking:
  mode: "pod"          # generator is a pure UDP client, no multicast required
